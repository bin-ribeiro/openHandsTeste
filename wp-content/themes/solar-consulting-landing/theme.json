{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "solar",
					"color": "#FFB703",
					"name": "Solar"
				},
				{
					"slug": "sunset",
					"color": "#FB8500",
					"name": "Sunset"
				},
				{
					"slug": "deep-blue",
					"color": "#023047",
					"name": "Azul Profundo"
				},
				{
					"slug": "sky",
					"color": "#8ECAE6",
					"name": "Céu"
				},
				{
					"slug": "light",
					"color": "#FDF8F0",
					"name": "Claro"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "Branco"
				},
				{
					"slug": "ink",
					"color": "#1D2A35",
					"name": "Tinta"
				}
			],
			"gradients": [
				{
					"slug": "solar-gradient",
					"gradient": "linear-gradient(135deg,#FFB703 0%,#FB8500 100%)",
					"name": "Gradiente Solar"
				}
			],
			"customDuotone": false,
			"customGradient": true,
			"link": true
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"slug": "system",
					"name": "Sistema"
				},
				{
					"fontFamily": "'Inter', system-ui, sans-serif",
					"slug": "inter",
					"name": "Inter"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Pequeno"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Médio"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Grande"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.5rem, 4vw, 2.25rem)",
					"name": "Extra Grande"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2rem, 5vw, 3.5rem)",
					"name": "Extra Extra Grande"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"spacing": {
			"blockGap": "1.5rem",
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "card",
					"shadow": "0 4px 20px rgba(2, 48, 71, 0.08)",
					"name": "Card"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"custom": {
			"spacing": {
				"section": "clamp(4rem, 8vw, 6rem)"
			},
			"typography": {
				"display-font-size": "clamp(2.5rem,  6vw, 4.5rem)"
			}
		}
	},
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--ink)",
			"background": "var(--wp--preset--color--white)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": "var(--wp--preset--color--sunset)",
				":hover": {
					"color": "var(--wp--preset--color--solar)"
				}
			},
			"heading": {
				"color": "var(--wp--preset--color--deep-blue)",
				"fontWeight": "700",
				"lineHeight": "1.15",
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			},
			"button": {
				"border": {
					"radius": "9999px"
				},
				"color": {
					"background": "var(--wp--preset--color--solar)",
					"text": "var(--wp--preset--color--deep-blue)"
				},
				"typography": {
					"fontWeight": "700"
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Cabeçalho",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Rodapé",
			"area": "footer"
		}
		,
		{
			"name": "cta",
			"title": "Chamada para Ação",
			"area": "uncategorized"
		}
	]
}